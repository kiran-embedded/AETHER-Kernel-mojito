# drivers/kernelsu-dispatch/Kconfig
#
# Aether Dual-KSU Dynamic Dispatch Layer
# =======================================
# This Kconfig replaces the single-variant KSU selection with a proper
# choice that lets the build system compile EITHER KernelSU-Next OR
# KernelSU (stock/tiann) — never both simultaneously.
#
# The existing 'drivers/kernelsu' symlink continues to point at the
# KernelSU-Next source tree.  When KSU_VARIANT_STOCK is chosen the
# build system instead compiles KernelSU/ (stock) from the root.
#
# Usage:
#   Build KernelSU-Next (default):
#       CONFIG_KSU_VARIANT_NEXT=y
#   Build stock KernelSU (tiann, UAPI v6):
#       CONFIG_KSU_VARIANT_STOCK=y
#
# Both selections expose the same CONFIG_KSU=y symbol so that all
# existing kernel code that guards on CONFIG_KSU continues to work
# without modification.
# ───────────────────────────────────────────────────────────────────

menu "KernelSU — Dynamic Dual Variant"

# ─── Top-level enable ──────────────────────────────────────────────
config KSU
	bool "Enable KernelSU root support"
	default y
	help
	  Master switch for KernelSU.  Enables kernel-level root
	  privileges on Android.  Select the variant below.

# ─── Variant choice ────────────────────────────────────────────────
choice
	prompt "KernelSU variant"
	depends on KSU
	default KSU_VARIANT_NEXT
	help
	  Select which KernelSU implementation to compile into the kernel.
	  Only one variant may be active per build.

config KSU_VARIANT_NEXT
	bool "KernelSU-Next (advanced / Datura fork)"
	help
	  Build KernelSU-Next from KernelSU-Next/kernel/.
	  Provides the full KernelSU-Next feature set (supercall,
	  preinit, advanced SELinux, SUSFS, etc.).
	  Manager: KernelSU-Next APK.

config KSU_VARIANT_STOCK
	bool "KernelSU stock (tiann / official, UAPI v6)"
	help
	  Build the stock (tiann/KernelSU) root engine from KernelSU/kernel/.
	  Reports UAPI version 6 to the manager.
	  Manager: official KernelSU APK (tiann/KernelSU releases).

endchoice

# ─── Next-specific options (forwarded to KernelSU-Next/kernel/Kconfig) ─
if KSU_VARIANT_NEXT

config KSU_DEBUG
	bool "KernelSU-Next debug mode"
	depends on KSU
	default n
	help
	  Enable KernelSU-Next debug logging.

config KSU_DISABLE_MANAGER
	bool "Disable KernelSU-Next manager integration"
	depends on KSU
	default n
	help
	  Disable APK manager detection and manager-specific handling.

config KSU_DISABLE_POLICY
	bool "Disable KernelSU-Next policy profiles"
	depends on KSU
	default n

config KSU_ALLOWLIST_WORKAROUND
	bool "KernelSU-Next allowlist workaround"
	depends on KSU
	default n

config KSU_MANUAL_HOOK
	bool "KernelSU-Next manual hook mode"
	depends on KSU && KSU != m
	default y if !KPROBES
	default n

choice
	prompt "KernelSU-Next dynamic hook mode"
	depends on KSU && !KSU_MANUAL_HOOK
	default KSU_KPROBES_HOOK

config KSU_KPROBES_HOOK
	bool "kretprobe + tracepoint hook"
	depends on KRETPROBES && KPROBES && HAVE_SYSCALL_TRACEPOINTS

config KSU_SYSCALL_TABLE_HOOK
	bool "Syscall table patching hook"
	depends on ARM64 || X86_64

endchoice

# SUSFS options for KernelSU-Next
menu "KernelSU-Next — SUSFS"
config KSU_SUSFS
	bool "SUSFS integration"
	depends on KSU_VARIANT_NEXT
	depends on THREAD_INFO_IN_TASK
	default y
config KSU_SUSFS_SUS_PATH
	bool "Hide suspicious paths"
	depends on KSU_SUSFS
	default y
config KSU_SUSFS_SUS_MOUNT
	bool "Hide suspicious mounts"
	depends on KSU_SUSFS
	default y
config KSU_SUSFS_SUS_KSTAT
	bool "Spoof suspicious kstat"
	depends on KSU_SUSFS
	default y
config KSU_SUSFS_TRY_UMOUNT
	bool "Use ksu try_umount"
	depends on KSU_SUSFS
	default y
config KSU_SUSFS_SPOOF_UNAME
	bool "Spoof uname"
	depends on KSU_SUSFS
	default y
config KSU_SUSFS_ENABLE_LOG
	bool "Enable SUSFS log"
	depends on KSU_SUSFS
	default y
config KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS
	bool "Hide ksu/susfs symbols from kallsyms"
	depends on KSU_SUSFS
	default y
config KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
	bool "Spoof cmdline/bootconfig"
	depends on KSU_SUSFS
	default y
config KSU_SUSFS_OPEN_REDIRECT
	bool "Path open redirect (experimental)"
	depends on KSU_SUSFS
	default y
config KSU_SUSFS_SUS_MAP
	bool "Hide mmapped real file from proc maps"
	depends on KSU_SUSFS
	default y
endmenu

endif # KSU_VARIANT_NEXT

# ─── Stock-specific options ─────────────────────────────────────────
if KSU_VARIANT_STOCK

config KSU_STOCK
	tristate "KernelSU stock module"
	depends on KSU_VARIANT_STOCK
	default y
	help
	  Compile the stock KernelSU root engine.
	  UAPI version is always 6.

config KSU_STOCK_DEBUG
	bool "KernelSU stock debug mode"
	depends on KSU_STOCK
	default n

config KSU_STOCK_SUSFS
	bool "KernelSU stock — SUSFS integration"
	depends on KSU_STOCK
	depends on THREAD_INFO_IN_TASK
	default y

endif # KSU_VARIANT_STOCK

endmenu
