# KernelSU stock — Kconfig
# Selected via CONFIG_KSU_VARIANT_STOCK=y
#

menu "KernelSU (stock / tiann)"

config KSU_STOCK
	tristate "KernelSU stock support"
	default y if KSU_VARIANT_STOCK
	depends on KSU_VARIANT_STOCK
	help
	  Enable the stock (tiann/KernelSU) root engine.
	  Reports UAPI version 6 to the manager application.
	  Requires manual-hook integration in the kernel.

config KSU_STOCK_DEBUG
	bool "KernelSU stock debug mode"
	depends on KSU_STOCK
	default n
	help
	  Enable verbose kernel logging for the stock KSU variant.

config KSU_STOCK_SUSFS
	bool "KernelSU stock — SUSFS integration"
	depends on KSU_STOCK
	depends on THREAD_INFO_IN_TASK
	default y
	help
	  Enable SUSFS (SUS File System) with the stock KernelSU variant.
	  Requires susfs patches to be applied to the kernel source.

endmenu
